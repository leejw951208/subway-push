{
    "name": "@subway-push/api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "node dist/src/main.js",
        "start:dev": "nest start --watch",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
